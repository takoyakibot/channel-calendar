APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

YOUTUBE_API_KEY=
# Days of already-ended streams to import per channel (default 14).
STREAMS_BACKFILL_DAYS=14
# Default keywords for the "X で告知を探す" link (from:@handle (a OR b ...)).
# Overridable at /admin/settings; channels can add their own in the channel edit form.
X_SEARCH_KEYWORDS=予定,配信,朝活,告知

# X announce bot (streams:announce): OAuth 1.0a keys of an app with Read and write
# permission, authorised by the posting account. Leave empty to disable posting.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Free plan allows 17 posts/24h per account and 1,500/month per app.
X_ANNOUNCE_DAILY_LIMIT=16
X_ANNOUNCE_MONTHLY_LIMIT=1400
X_ANNOUNCE_QUEUE_DAYS=3

# Google Analytics 4 measurement id. Leave empty to disable the tag (e.g. locally).
# The tag is only loaded after the visitor accepts optional cookies.
GA4_MEASUREMENT_ID=

# Comma-separated list of email addresses that are granted admin on Google login.
ADMIN_EMAILS=admin@example.com
